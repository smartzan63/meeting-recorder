# Copy this file to .env and fill in your values.
# .env is never committed — see .gitignore.

# --- Transcription provider policy ---

# Primary backend: azure (default), gemini, or mock. "mock" returns a canned
# transcript instantly and is intended only for UI testing.
PRIMARY_PROVIDER=azure

# Optional fallback backend after a technical primary-provider failure. Leave
# empty to disable fallback. Valid values: azure or gemini.
FALLBACK_PROVIDER=

# --- OBS (required for all providers) ---

# OBS WebSocket password (Tools → WebSocket Server Settings in OBS)
OBS_PASSWORD=

# OBS WebSocket host/port (default: localhost:4455)
# OBS_HOST=localhost
# OBS_PORT=4455

# --- Gemini (required for gemini primary or enabled fallback) ---

# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- Azure (required when PRIMARY_PROVIDER=azure) ---

# Azure AI Speech - for transcription + speaker diarization
# Create a Speech resource in Azure Portal (Cognitive Services → Speech)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Azure OpenAI - for summarization and speaker name enrichment
# Create an Azure OpenAI resource and deploy a chat-completions model (e.g. gpt-5.2)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# --- Storage (optional) ---

# Directories for recordings, transcripts, and summaries (defaults shown)
# RECORDINGS_DIR=./data/audio
# TRANSCRIPTS_DIR=./data/transcripts
# SUMMARIES_DIR=./data/summaries
#
# To store transcripts on a host path outside the project, the path must be
# bind-mounted into the container in docker-compose.yml and TRANSCRIPTS_DIR set
# to the in-container mount path. The compose file mounts
# ${TRANSCRIPTS_HOST_DIR} -> /app/external-transcripts, so set:
# TRANSCRIPTS_HOST_DIR=/absolute/host/path/to/transcripts   (compose interpolation)
# TRANSCRIPTS_DIR=/app/external-transcripts                 (path seen inside container)
# Windows: use forward slashes and no quotes/backslashes for the host path, e.g.
# TRANSCRIPTS_HOST_DIR=C:/Users/you/meeting-transcripts
# Leave TRANSCRIPTS_DIR as the /app/... container path on every OS.

# Web server port (default: 8080)
# PORT=8080

# --- Confluence export (optional) ---

# Atlassian Cloud API token: https://id.atlassian.com/manage-profile/security/api-tokens
# CONFLUENCE_URL=https://yourcompany.atlassian.net
# CONFLUENCE_EMAIL=you@yourcompany.com
# CONFLUENCE_TOKEN=
# CONFLUENCE_SPACE_KEY=
# CONFLUENCE_PARENT_PAGE_ID=

# --- Notion export (optional) ---

# Notion Integration Token: https://www.notion.so/my-integrations
# Both vars required to enable the Notion export button in the UI
# NOTION_TOKEN=secret_xxx
# NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Export options ---

# Set to "true" to include the full transcript in Confluence/Notion exports.
# Default is false — only the summary is exported.
# EXPORT_INCLUDE_TRANSCRIPT=false

# --- Speaker naming (optional) ---
# Participant roster used as a prior when naming speakers. Without it the model
# writes whatever name it heard, so a mishearing becomes a speaker name and two
# people with similar names can both end up called the same thing.
#
# Defaults to roster.json inside TRANSCRIPTS_DIR, which is already a host path
# outside this repo — so real names stay out of the project with no extra setup.
# Set this only to keep it somewhere else. Copy roster.example.json to start.
# ROSTER_PATH=/absolute/host/path/to/roster.json
