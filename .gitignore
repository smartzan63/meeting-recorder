# Secrets — never commit
.env
compose.override.yaml

# Runtime data — personal recordings and transcripts
recordings/*
!recordings/.gitkeep
transcripts/*
!transcripts/.gitkeep
# Ignore all runtime data, but keep an empty data/transcripts/ so the default
# bind-mount source exists on a fresh clone (matters on Windows hosts).
data/*
!data/transcripts/
data/transcripts/*
!data/transcripts/.gitkeep

# Test recordings — may contain personal audio
test_recordings/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Virtual environments
venv/
.venv/
env/

# macOS
.DS_Store

# Editor
.idea/
.vscode/
*.swp

# Frontend build artifacts
frontend/node_modules/
frontend/dist/
